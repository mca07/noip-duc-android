<?xml version="1.0" encoding="utf-8"?>
<!-- Unverschlüsselter Verkehr verboten; nur System-Zertifikate (keine Nutzer-CAs → kein einfaches MITM). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
